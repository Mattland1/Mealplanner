# Authentication is disabled by default for trusted home-network use.
SAVOR_PASSWORD=
SAVOR_SESSION_SECRET=

# Optional: if you decide to enable a password, set both values. The session secret
# must be a different random string containing at least 32 characters.
# SAVOR_PASSWORD=choose-a-long-household-password
# SAVOR_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
